DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Verified Google identity allowed to bootstrap the platform owner for this installation
PLATFORM_OWNER_EMAIL=owner@example.com
# Google OAuth (create a Web application client; callback: https://YOUR_DOMAIN/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_NAME=CENCOM Điều phối bê tông
DB_POOL_MAX=2
# Optional Web Push. Use a separately generated VAPID key pair per environment.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@cencom.vn
# Password reset email (Gmail / Google Workspace SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM=
